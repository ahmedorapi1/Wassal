generator client {
  provider = "prisma-client"
  output   = "../../../packages/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  COURIER
  SUPPORT
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum UserLocale {
  AR_EG
  EN
}

enum MerchantStatus {
  PENDING
  CHANGES_REQUESTED
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum BillingMode {
  PER_ORDER
  MONTHLY_INVOICE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum CourierVerificationStatus {
  DRAFT
  INCOMPLETE
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourierAvailability {
  OFFLINE
  ONLINE
  ON_DELIVERY
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
}

enum DocumentType {
  NATIONAL_ID
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  DRIVING_LICENSE
  DRIVER_LICENSE
  VEHICLE_LICENSE
  PROFILE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  SUPERSEDED
}

enum OrderStatus {
  DRAFT
  QUOTED
  SEARCHING_COURIER
  NO_COURIER_AVAILABLE
  NO_COURIER_AVAILABLE_FINAL
  COURIER_ASSIGNED
  COURIER_ARRIVING_PICKUP
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_DROPOFF
  DELIVERED
  DELIVERY_DISPUTED
  DELIVERY_FAILED
  RETURNING_TO_STORE
  RETURN_AWAITING_MERCHANT_CONFIRMATION
  RETURNED
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  DELIVERY_ONLY
  CASH_ON_DELIVERY
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum AddressSource {
  MANUAL
  SAVED
  STORE
}

enum AddressValidationStatus {
  UNVERIFIED
  VALIDATED
  REJECTED
}

enum ServiceZoneStatus {
  ACTIVE
  INACTIVE
}

enum PricingRuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
  RETIRED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum QuoteStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  CONSUMED
  CANCELLED
}

enum OrderEventType {
  ORDER_DRAFT_CREATED
  QUOTE_CREATED
  QUOTE_RECALCULATED
  QUOTE_EXPIRED
  ORDER_CONFIRMED
  COURIER_SEARCH_REQUESTED
  COURIER_SEARCH_EXPIRED
  COURIER_SEARCH_RESTARTED
  COURIER_ACCEPTED
  COURIER_ARRIVING_PICKUP
  COURIER_ARRIVED_PICKUP
  ORDER_PICKED_UP
  ORDER_IN_TRANSIT
  COURIER_ARRIVED_DROPOFF
  ORDER_DELIVERED
  DELIVERY_DISPUTE_CREATED
  DELIVERY_DISPUTE_COURIER_RESPONDED
  DELIVERY_DISPUTE_RESOLVED
  ORDER_COMPLETED
  DELIVERY_FAILED
  RETURNING_TO_STORE
  RETURN_AWAITING_MERCHANT_CONFIRMATION
  RETURN_CONFIRMED
  RETURN_ADMIN_OVERRIDE
  ORDER_RETURNED
  COURIER_CANCELLED
  ADMIN_CANCELLED
  ORDER_CANCELLED
  MERCHANT_CANCELLED_AFTER_PICKUP
  ORDER_NOTE_UPDATED
}

enum OrderEventSource {
  MERCHANT_WEB
  ADMIN_WEB
  COURIER_MOBILE
  WORKER
  SYSTEM
  API
}

enum OrderActorType {
  USER
  SYSTEM
}

enum DispatchOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ProofType {
  OTP
  PHOTO
  SIGNATURE
  MUTUAL_CONFIRMATION
}

enum WalletOwnerType {
  MERCHANT
  COURIER
  PLATFORM
}

enum LedgerEntryType {
  DELIVERY_FEE
  COURIER_EARNING
  PLATFORM_COMMISSION
  CASH_COLLECTED
  SETTLEMENT
  ADJUSTMENT
  REFUND
}

enum SettlementOwnerType {
  MERCHANT
  COURIER
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SettlementCycleType {
  WEEKLY
}

enum CourierLedgerEntryType {
  COMMISSION_DUE
  EXTERNAL_PAYMENT
  ADJUSTMENT_DEBIT
  ADJUSTMENT_CREDIT
  WAIVER
  REVERSAL
}

enum CourierSettlementStatus {
  OPEN
  CLOSED
  NOT_DUE
  DUE_SOON
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  ADJUSTED
}

enum ExternalPaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_WALLET_EXTERNAL
  OTHER
}

enum SupportCaseType {
  DELIVERY_ISSUE
  PAYMENT_ISSUE
  DAMAGED_PACKAGE
  LOST_PACKAGE
  SAFETY
  OTHER
}

enum SupportCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum FeatureFlagScope {
  GLOBAL
  CITY
  MERCHANT
  COURIER
}

enum OtpPurpose {
  SIGN_IN
  VERIFY_PHONE
  CONFIRM_DELIVERY
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum DeliveryDisputeReason {
  COURIER_DID_NOT_ARRIVE
  CUSTOMER_DID_NOT_RECEIVE
  WRONG_RECIPIENT
  INCOMPLETE_DELIVERY
  DAMAGED_DELIVERY
  MARKED_DELIVERED_BY_MISTAKE
  OTHER
}

enum DeliveryDisputeStatus {
  OPEN
  COURIER_RESPONDED
  RESOLVED_DELIVERY_CONFIRMED
  RESOLVED_NOT_DELIVERED
  RESOLVED_RETURN_REQUIRED
  CANCELLED_BY_ADMIN
}

enum DeliveryFailureReason {
  CUSTOMER_NO_ANSWER
  PHONE_OFF
  WRONG_ADDRESS
  CUSTOMER_ABSENT
  CUSTOMER_REFUSED
  CUSTOMER_CANCELLED
  INCORRECT_INFORMATION
  INACCESSIBLE_LOCATION
  PRODUCT_ISSUE
  COURIER_EMERGENCY
  OTHER
}

enum ReturnCondition {
  INTACT
  DAMAGED
  INCOMPLETE
  OTHER
}

enum OrderCompletionSource {
  DISPUTE_WINDOW_EXPIRED
  ADMIN_CONFIRMED_DELIVERY
  MERCHANT_CONFIRMED_RETURN
  ADMIN_RETURN_OVERRIDE
}

enum PaymentProofStatus {
  PENDING_CONFIRMATION
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELLED_BY_COURIER
  SUPERSEDED
}

model User {
  id                    String                       @id @default(uuid()) @db.Uuid
  phone                 String                       @unique @db.VarChar(20)
  email                 String?                      @unique @db.VarChar(320)
  displayName           String?                      @db.VarChar(160)
  role                  UserRole
  status                UserStatus                   @default(PENDING)
  locale                UserLocale                   @default(AR_EG)
  phoneVerifiedAt       DateTime?                    @db.Timestamptz(3)
  passwordHash          String?                      @db.VarChar(255)
  passwordChangedAt     DateTime?                    @db.Timestamptz(3)
  forcePasswordChange   Boolean                      @default(false)
  failedLoginAttempts   Int                          @default(0)
  lockedUntil           DateTime?                    @db.Timestamptz(3)
  lastSignedInAt        DateTime?                    @db.Timestamptz(3)
  createdAt             DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(3)
  merchantMemberships   MerchantMembership[]
  courierProfile        CourierProfile?
  orderEvents           OrderEvent[]
  ratingsGiven          Rating[]                     @relation("RatingAuthor")
  ratingsReceived       Rating[]                     @relation("RatingSubject")
  auditLogs             AuditLog[]
  otpChallenges         OtpChallenge[]
  sessions              Session[]
  reviewedDocuments     CourierDocument[]            @relation("DocumentReviewer")
  verificationEvents    CourierVerificationEvent[]   @relation("VerificationActor")
  createdQuotes         PriceQuote[]                 @relation("QuoteCreator")
  createdOrders         DeliveryOrder[]              @relation("OrderCreator")
  cancelledOrders       DeliveryOrder[]              @relation("OrderCanceller")
  financialSettings     PlatformFinancialSetting[]   @relation("FinancialSettingCreator")
  courierZoneGrants     CourierServiceZone[]         @relation("CourierZoneCreator")
  courierLedgerEntries  CourierLedgerEntry[]         @relation("CourierLedgerCreator")
  externalPayments      ExternalPaymentRecord[]      @relation("ExternalPaymentCreator")
  notifications         Notification[]
  createdDisputes       DeliveryDispute[]            @relation("DisputeCreator")
  resolvedDisputes      DeliveryDispute[]            @relation("DisputeResolver")
  reviewedPaymentProofs CourierPaymentProof[]        @relation("PaymentProofReviewer")
  paymentProofReviews   PaymentProofReview[]         @relation("PaymentProofReviewActor")
  operationalSettings   PlatformOperationalSetting[] @relation("OperationalSettingCreator")

  @@index([role, status])
}

model Merchant {
  id               String               @id @default(uuid()) @db.Uuid
  legalName        String               @db.VarChar(200)
  displayName      String               @db.VarChar(160)
  businessCategory String?              @db.VarChar(120)
  contactPhone     String?              @db.VarChar(20)
  contactEmail     String?              @db.VarChar(320)
  status           MerchantStatus       @default(PENDING)
  reviewNotes      String?
  reviewedAt       DateTime?            @db.Timestamptz(3)
  billingMode      BillingMode          @default(PER_ORDER)
  commissionRate   Decimal              @default(0) @db.Decimal(5, 4)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  memberships      MerchantMembership[]
  stores           Store[]
  customers        Customer[]
  addresses        Address[]
  orders           DeliveryOrder[]
  quotes           PriceQuote[]
  deliveryDisputes DeliveryDispute[]

  @@index([status])
}

model MerchantMembership {
  id            String    @id @default(uuid()) @db.Uuid
  merchantId    String    @db.Uuid
  userId        String    @db.Uuid
  role          UserRole
  active        Boolean   @default(true)
  invitedById   String?   @db.Uuid
  deactivatedAt DateTime? @db.Timestamptz(3)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId, active])
  @@index([merchantId, role, active])
}

model Store {
  id             String                                 @id @default(uuid()) @db.Uuid
  merchantId     String                                 @db.Uuid
  name           String                                 @db.VarChar(160)
  phone          String?                                @db.VarChar(20)
  addressLine    String                                 @db.VarChar(500)
  governorate    String?                                @db.VarChar(120)
  city           String                                 @db.VarChar(120)
  area           String                                 @db.VarChar(120)
  street         String?                                @db.VarChar(240)
  addressDetails String?                                @db.VarChar(500)
  location       Unsupported("geography(Point, 4326)")?
  workingHours   Json?
  status         StoreStatus                            @default(ACTIVE)
  version        Int                                    @default(1)
  createdAt      DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                               @updatedAt @db.Timestamptz(3)
  merchant       Merchant                               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  pickupOrders   DeliveryOrder[]
  quotes         PriceQuote[]

  @@index([merchantId, status])
  @@index([city, area])
}

model CourierProfile {
  id                    String                                 @id @default(uuid()) @db.Uuid
  userId                String                                 @unique @db.Uuid
  fullName              String                                 @db.VarChar(160)
  emergencyContactName  String?                                @db.VarChar(160)
  emergencyContactPhone String?                                @db.VarChar(20)
  verificationStatus    CourierVerificationStatus              @default(INCOMPLETE)
  availability          CourierAvailability                    @default(OFFLINE)
  rating                Decimal                                @default(0) @db.Decimal(3, 2)
  completedOrdersCount  Int                                    @default(0)
  cashLimit             Decimal                                @default(0) @db.Decimal(12, 2)
  preferredCity         String?                                @db.VarChar(120)
  lastLocation          Unsupported("geography(Point, 4326)")?
  lastLocationAt        DateTime?                              @db.Timestamptz(3)
  approvedAt            DateTime?                              @db.Timestamptz(3)
  submittedAt           DateTime?                              @db.Timestamptz(3)
  rejectedAt            DateTime?                              @db.Timestamptz(3)
  suspendedAt           DateTime?                              @db.Timestamptz(3)
  statusReason          String?
  version               Int                                    @default(1)
  createdAt             DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                               @updatedAt @db.Timestamptz(3)
  user                  User                                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicles              Vehicle[]
  documents             CourierDocument[]
  assignedOrders        DeliveryOrder[]
  dispatchOffers        DispatchOffer[]
  trackingPoints        TrackingPoint[]
  verificationEvents    CourierVerificationEvent[]
  serviceZones          CourierServiceZone[]
  courierLedgerEntries  CourierLedgerEntry[]
  settlementPeriods     SettlementPeriod[]
  externalPayments      ExternalPaymentRecord[]
  deliveryDisputes      DeliveryDispute[]
  paymentProofs         CourierPaymentProof[]

  @@index([verificationStatus, availability])
}

model Vehicle {
  id           String            @id @default(uuid()) @db.Uuid
  courierId    String            @db.Uuid
  type         VehicleType       @default(MOTORCYCLE)
  plateNumber  String            @unique @db.VarChar(40)
  manufacturer String?           @db.VarChar(100)
  model        String?           @db.VarChar(100)
  color        String?           @db.VarChar(60)
  active       Boolean           @default(true)
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  courier      CourierProfile    @relation(fields: [courierId], references: [id], onDelete: Restrict)
  documents    CourierDocument[]

  @@index([courierId, active])
}

model CourierDocument {
  id               String            @id @default(uuid()) @db.Uuid
  courierId        String            @db.Uuid
  vehicleId        String?           @db.Uuid
  type             DocumentType
  status           DocumentStatus    @default(PENDING)
  storageKey       String            @db.VarChar(500)
  originalFilename String            @db.VarChar(255)
  contentType      String            @db.VarChar(120)
  sizeBytes        Int
  checksumSha256   String            @db.Char(64)
  documentNumber   String?           @db.VarChar(100)
  issuedAt         DateTime?         @db.Date
  expiresAt        DateTime?         @db.Date
  reviewedById     String?           @db.Uuid
  reviewedAt       DateTime?         @db.Timestamptz(3)
  reviewNotes      String?
  version          Int               @default(1)
  reviewVersion    Int               @default(1)
  isCurrent        Boolean           @default(true)
  supersedesId     String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  courier          CourierProfile    @relation(fields: [courierId], references: [id], onDelete: Restrict)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  supersedes       CourierDocument?  @relation("DocumentVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacements     CourierDocument[] @relation("DocumentVersions")

  @@index([courierId, isCurrent, status])
  @@index([status, createdAt])
  @@index([expiresAt, isCurrent])
}

model CourierVerificationEvent {
  id         BigInt                     @id @default(autoincrement())
  courierId  String                     @db.Uuid
  actorId    String?                    @db.Uuid
  action     String                     @db.VarChar(100)
  fromStatus CourierVerificationStatus?
  toStatus   CourierVerificationStatus?
  reason     String?
  metadata   Json?
  createdAt  DateTime                   @default(now()) @db.Timestamptz(3)
  courier    CourierProfile             @relation(fields: [courierId], references: [id], onDelete: Restrict)
  actor      User?                      @relation("VerificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([courierId, createdAt])
  @@index([actorId, createdAt])
}

model Customer {
  id              String          @id @default(uuid()) @db.Uuid
  merchantId      String          @db.Uuid
  name            String          @db.VarChar(160)
  normalizedPhone String          @db.VarChar(20)
  email           String?         @db.VarChar(320)
  notes           String?
  status          CustomerStatus  @default(ACTIVE)
  archivedAt      DateTime?       @db.Timestamptz(3)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  addresses       Address[]
  orders          DeliveryOrder[]
  quotes          PriceQuote[]

  @@unique([merchantId, normalizedPhone])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, name])
}

model Address {
  id               String                                 @id @default(uuid()) @db.Uuid
  merchantId       String                                 @db.Uuid
  customerId       String?                                @db.Uuid
  label            String?                                @db.VarChar(100)
  contactName      String                                 @db.VarChar(160)
  contactPhone     String                                 @db.VarChar(20)
  addressLine      String                                 @db.VarChar(500)
  street           String?                                @db.VarChar(240)
  buildingNumber   String?                                @db.VarChar(40)
  floor            String?                                @db.VarChar(40)
  apartment        String?                                @db.VarChar(40)
  landmark         String?                                @db.VarChar(240)
  area             String                                 @db.VarChar(120)
  city             String                                 @db.VarChar(120)
  governorate      String                                 @db.VarChar(120)
  instructions     String?
  deliveryNotes    String?
  sourceMapsUrl    String?                                @db.VarChar(1000)
  latitude         Decimal                                @db.Decimal(9, 6)
  longitude        Decimal                                @db.Decimal(9, 6)
  location         Unsupported("geography(Point, 4326)")?
  source           AddressSource                          @default(MANUAL)
  validationStatus AddressValidationStatus                @default(UNVERIFIED)
  archivedAt       DateTime?                              @db.Timestamptz(3)
  version          Int                                    @default(1)
  createdAt        DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                               @updatedAt @db.Timestamptz(3)
  merchant         Merchant                               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer         Customer?                              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickupOrders     DeliveryOrder[]                        @relation("PickupAddress")
  dropoffOrders    DeliveryOrder[]                        @relation("DropoffAddress")

  @@index([merchantId, customerId, archivedAt])
  @@index([city, area])
}

model DeliveryOrder {
  id                            String                 @id @default(uuid()) @db.Uuid
  orderNumber                   String                 @unique @db.VarChar(32)
  quoteId                       String                 @unique @db.Uuid
  merchantId                    String                 @db.Uuid
  storeId                       String                 @db.Uuid
  customerId                    String?                @db.Uuid
  pickupAddressId               String                 @db.Uuid
  dropoffAddressId              String                 @db.Uuid
  serviceZoneId                 String                 @db.Uuid
  pricingRuleId                 String                 @db.Uuid
  createdById                   String                 @db.Uuid
  courierId                     String?                @db.Uuid
  status                        OrderStatus            @default(DRAFT)
  acceptanceExpiresAt           DateTime?              @db.Timestamptz(3)
  dispatchAttemptCount          Int                    @default(0)
  paymentMode                   PaymentMode            @default(DELIVERY_ONLY)
  customerSnapshot              Json
  pickupAddressSnapshot         Json
  dropoffAddressSnapshot        Json
  packageSnapshot               Json
  routeSnapshot                 Json
  pricingSnapshot               Json
  packageCategory               String                 @db.VarChar(100)
  itemDescription               String                 @db.VarChar(240)
  packageSize                   PackageSize            @default(SMALL)
  weightGrams                   Int
  packageCount                  Int                    @default(1)
  fragile                       Boolean                @default(false)
  requiresThermalBag            Boolean                @default(false)
  recipientNotes                String?
  courierNotes                  String?
  declaredValueMinor            Int
  prohibitedItemsConfirmed      Boolean                @default(false)
  merchantReference             String?                @db.VarChar(100)
  customerOrderReference        String?                @db.VarChar(100)
  routeDistanceMeters           Int
  estimatedDurationSeconds      Int
  baseFeeMinor                  Int
  distanceChargeMinor           Int
  packageSurchargeMinor         Int
  weightSurchargeMinor          Int
  fragileSurchargeMinor         Int
  thermalBagSurchargeMinor      Int
  discountMinor                 Int                    @default(0)
  surgeAdjustmentMinor          Int                    @default(0)
  taxMinor                      Int                    @default(0)
  merchantTotalMinor            Int
  estimatedCourierEarningMinor  Int
  platformCommissionMinor       Int
  platformCommissionBasisPoints Int
  currency                      String                 @default("EGP") @db.Char(3)
  pricingVersion                Int
  deliveredAt                   DateTime?              @db.Timestamptz(3)
  deliveryDisputeDeadlineAt     DateTime?              @db.Timestamptz(3)
  completedAt                   DateTime?              @db.Timestamptz(3)
  completionSource              OrderCompletionSource?
  deliveryNote                  String?
  deliveryFailureReason         DeliveryFailureReason?
  deliveryFailureNote           String?
  returnReportedAt              DateTime?              @db.Timestamptz(3)
  returnConfirmedAt             DateTime?              @db.Timestamptz(3)
  returnConfirmedById           String?                @db.Uuid
  returnCondition               ReturnCondition?
  returnConfirmationNote        String?
  financialFinalizedAt          DateTime?              @db.Timestamptz(3)
  cancelledAt                   DateTime?              @db.Timestamptz(3)
  cancelledById                 String?                @db.Uuid
  cancellationReasonCode        String?                @db.VarChar(80)
  cancellationDetails           String?
  cancelledByRole               UserRole?
  cancelledAfterPickup          Boolean                @default(false)
  cancellationChargeMinor       Int                    @default(0)
  version                       Int                    @default(1)
  createdAt                     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime               @updatedAt @db.Timestamptz(3)
  quote                         PriceQuote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  merchant                      Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store                         Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer                      Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pickupAddress                 Address                @relation("PickupAddress", fields: [pickupAddressId], references: [id], onDelete: Restrict)
  dropoffAddress                Address                @relation("DropoffAddress", fields: [dropoffAddressId], references: [id], onDelete: Restrict)
  serviceZone                   ServiceZone            @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)
  pricingRule                   PricingRule            @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)
  createdBy                     User                   @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy                   User?                  @relation("OrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  courier                       CourierProfile?        @relation(fields: [courierId], references: [id], onDelete: Restrict)
  events                        OrderEvent[]
  dispatchOffers                DispatchOffer[]
  trackingPoints                TrackingPoint[]
  proofs                        ProofOfDelivery[]
  ledgerEntries                 LedgerEntry[]
  courierLedgerEntries          CourierLedgerEntry[]
  ratings                       Rating[]
  supportCases                  SupportCase[]
  deliveryDispute               DeliveryDispute?

  @@index([merchantId, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([courierId, status])
  @@index([status, createdAt])
  @@index([status, acceptanceExpiresAt])
  @@index([status, deliveryDisputeDeadlineAt])
  @@index([serviceZoneId, status, createdAt])
  @@index([cancelledAt, cancellationReasonCode])
  @@index([cancelledById, cancelledAt])
}

