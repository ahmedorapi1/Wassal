generator client {
  provider = "prisma-client"
  output   = "../../../packages/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  COURIER
  SUPPORT
  OPERATIONS_ADMIN
  FINANCE_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum UserLocale {
  AR_EG
  EN
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum BillingMode {
  PER_ORDER
  MONTHLY_INVOICE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum CourierVerificationStatus {
  DRAFT
  INCOMPLETE
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourierAvailability {
  OFFLINE
  ONLINE
  ON_DELIVERY
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
}

enum DocumentType {
  NATIONAL_ID
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  DRIVING_LICENSE
  DRIVER_LICENSE
  VEHICLE_LICENSE
  PROFILE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  SUPERSEDED
}

enum OrderStatus {
  DRAFT
  QUOTED
  SEARCHING_COURIER
  COURIER_ASSIGNED
  COURIER_ARRIVING_PICKUP
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_DROPOFF
  DELIVERED
  DELIVERY_FAILED
  RETURNING_TO_STORE
  RETURNED
  CANCELLED
}

enum PaymentMode {
  DELIVERY_ONLY
  CASH_ON_DELIVERY
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum DispatchOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum ProofType {
  OTP
  PHOTO
  SIGNATURE
  MUTUAL_CONFIRMATION
}

enum WalletOwnerType {
  MERCHANT
  COURIER
  PLATFORM
}

enum LedgerEntryType {
  DELIVERY_FEE
  COURIER_EARNING
  PLATFORM_COMMISSION
  CASH_COLLECTED
  SETTLEMENT
  ADJUSTMENT
  REFUND
}

enum SettlementOwnerType {
  MERCHANT
  COURIER
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SupportCaseType {
  DELIVERY_ISSUE
  PAYMENT_ISSUE
  DAMAGED_PACKAGE
  LOST_PACKAGE
  SAFETY
  OTHER
}

enum SupportCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum FeatureFlagScope {
  GLOBAL
  CITY
  MERCHANT
  COURIER
}

enum OtpPurpose {
  SIGN_IN
  VERIFY_PHONE
  CONFIRM_DELIVERY
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                  String                     @id @default(uuid()) @db.Uuid
  phone               String                     @unique @db.VarChar(20)
  email               String?                    @unique @db.VarChar(320)
  displayName         String?                    @db.VarChar(160)
  role                UserRole
  status              UserStatus                 @default(PENDING)
  locale              UserLocale                 @default(AR_EG)
  phoneVerifiedAt     DateTime?                  @db.Timestamptz(3)
  lastSignedInAt      DateTime?                  @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  merchantMemberships MerchantMembership[]
  courierProfile      CourierProfile?
  orderEvents         OrderEvent[]
  ratingsGiven        Rating[]                   @relation("RatingAuthor")
  ratingsReceived     Rating[]                   @relation("RatingSubject")
  auditLogs           AuditLog[]
  otpChallenges       OtpChallenge[]
  sessions            Session[]
  reviewedDocuments   CourierDocument[]          @relation("DocumentReviewer")
  verificationEvents  CourierVerificationEvent[] @relation("VerificationActor")

  @@index([role, status])
}

model Merchant {
  id             String               @id @default(uuid()) @db.Uuid
  legalName      String               @db.VarChar(200)
  displayName    String               @db.VarChar(160)
  status         MerchantStatus       @default(PENDING)
  billingMode    BillingMode          @default(PER_ORDER)
  commissionRate Decimal              @default(0) @db.Decimal(5, 4)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  memberships    MerchantMembership[]
  stores         Store[]
  customers      Customer[]
  addresses      Address[]
  orders         DeliveryOrder[]

  @@index([status])
}

model MerchantMembership {
  id            String    @id @default(uuid()) @db.Uuid
  merchantId    String    @db.Uuid
  userId        String    @db.Uuid
  role          UserRole
  active        Boolean   @default(true)
  invitedById   String?   @db.Uuid
  deactivatedAt DateTime? @db.Timestamptz(3)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId, active])
  @@index([merchantId, role, active])
}

model Store {
  id           String                                 @id @default(uuid()) @db.Uuid
  merchantId   String                                 @db.Uuid
  name         String                                 @db.VarChar(160)
  phone        String?                                @db.VarChar(20)
  addressLine  String                                 @db.VarChar(500)
  area         String                                 @db.VarChar(120)
  city         String                                 @db.VarChar(120)
  location     Unsupported("geography(Point, 4326)")?
  workingHours Json?
  status       StoreStatus                            @default(ACTIVE)
  version      Int                                    @default(1)
  createdAt    DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                               @updatedAt @db.Timestamptz(3)
  merchant     Merchant                               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  pickupOrders DeliveryOrder[]

  @@index([merchantId, status])
  @@index([city, area])
}

model CourierProfile {
  id                    String                                 @id @default(uuid()) @db.Uuid
  userId                String                                 @unique @db.Uuid
  fullName              String                                 @db.VarChar(160)
  emergencyContactName  String?                                @db.VarChar(160)
  emergencyContactPhone String?                                @db.VarChar(20)
  verificationStatus    CourierVerificationStatus              @default(INCOMPLETE)
  availability          CourierAvailability                    @default(OFFLINE)
  rating                Decimal                                @default(0) @db.Decimal(3, 2)
  completedOrdersCount  Int                                    @default(0)
  cashLimit             Decimal                                @default(0) @db.Decimal(12, 2)
  preferredCity         String?                                @db.VarChar(120)
  lastLocation          Unsupported("geography(Point, 4326)")?
  lastLocationAt        DateTime?                              @db.Timestamptz(3)
  approvedAt            DateTime?                              @db.Timestamptz(3)
  submittedAt           DateTime?                              @db.Timestamptz(3)
  rejectedAt            DateTime?                              @db.Timestamptz(3)
  suspendedAt           DateTime?                              @db.Timestamptz(3)
  statusReason          String?
  version               Int                                    @default(1)
  createdAt             DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                               @updatedAt @db.Timestamptz(3)
  user                  User                                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicles              Vehicle[]
  documents             CourierDocument[]
  assignedOrders        DeliveryOrder[]
  dispatchOffers        DispatchOffer[]
  trackingPoints        TrackingPoint[]
  verificationEvents    CourierVerificationEvent[]

  @@index([verificationStatus, availability])
}

model Vehicle {
  id           String            @id @default(uuid()) @db.Uuid
  courierId    String            @db.Uuid
  type         VehicleType       @default(MOTORCYCLE)
  plateNumber  String            @unique @db.VarChar(40)
  manufacturer String?           @db.VarChar(100)
  model        String?           @db.VarChar(100)
  color        String?           @db.VarChar(60)
  active       Boolean           @default(true)
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  courier      CourierProfile    @relation(fields: [courierId], references: [id], onDelete: Restrict)
  documents    CourierDocument[]

  @@index([courierId, active])
}

model CourierDocument {
  id               String            @id @default(uuid()) @db.Uuid
  courierId        String            @db.Uuid
  vehicleId        String?           @db.Uuid
  type             DocumentType
  status           DocumentStatus    @default(PENDING)
  storageKey       String            @db.VarChar(500)
  originalFilename String            @db.VarChar(255)
  contentType      String            @db.VarChar(120)
  sizeBytes        Int
  checksumSha256   String            @db.Char(64)
  documentNumber   String?           @db.VarChar(100)
  issuedAt         DateTime?         @db.Date
  expiresAt        DateTime?         @db.Date
  reviewedById     String?           @db.Uuid
  reviewedAt       DateTime?         @db.Timestamptz(3)
  reviewNotes      String?
  version          Int               @default(1)
  reviewVersion    Int               @default(1)
  isCurrent        Boolean           @default(true)
  supersedesId     String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  courier          CourierProfile    @relation(fields: [courierId], references: [id], onDelete: Restrict)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  supersedes       CourierDocument?  @relation("DocumentVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacements     CourierDocument[] @relation("DocumentVersions")

  @@index([courierId, isCurrent, status])
  @@index([status, createdAt])
  @@index([expiresAt, isCurrent])
}

model CourierVerificationEvent {
  id         BigInt                     @id @default(autoincrement())
  courierId  String                     @db.Uuid
  actorId    String?                    @db.Uuid
  action     String                     @db.VarChar(100)
  fromStatus CourierVerificationStatus?
  toStatus   CourierVerificationStatus?
  reason     String?
  metadata   Json?
  createdAt  DateTime                   @default(now()) @db.Timestamptz(3)
  courier    CourierProfile             @relation(fields: [courierId], references: [id], onDelete: Restrict)
  actor      User?                      @relation("VerificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([courierId, createdAt])
  @@index([actorId, createdAt])
}

model Customer {
  id         String          @id @default(uuid()) @db.Uuid
  merchantId String          @db.Uuid
  name       String          @db.VarChar(160)
  phone      String          @db.VarChar(20)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  addresses  Address[]
  orders     DeliveryOrder[]

  @@unique([merchantId, phone])
}

model Address {
  id            String                                 @id @default(uuid()) @db.Uuid
  merchantId    String                                 @db.Uuid
  customerId    String?                                @db.Uuid
  label         String?                                @db.VarChar(100)
  addressLine   String                                 @db.VarChar(500)
  area          String                                 @db.VarChar(120)
  city          String                                 @db.VarChar(120)
  instructions  String?
  location      Unsupported("geography(Point, 4326)")?
  createdAt     DateTime                               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                               @updatedAt @db.Timestamptz(3)
  merchant      Merchant                               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer      Customer?                              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pickupOrders  DeliveryOrder[]                        @relation("PickupAddress")
  dropoffOrders DeliveryOrder[]                        @relation("DropoffAddress")

  @@index([merchantId, customerId])
  @@index([city, area])
}

model DeliveryOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  reference          String            @unique @db.VarChar(32)
  merchantId         String            @db.Uuid
  storeId            String            @db.Uuid
  customerId         String?           @db.Uuid
  pickupAddressId    String            @db.Uuid
  dropoffAddressId   String            @db.Uuid
  courierId          String?           @db.Uuid
  status             OrderStatus       @default(DRAFT)
  paymentMode        PaymentMode       @default(DELIVERY_ONLY)
  packageCategory    String            @db.VarChar(100)
  packageSize        PackageSize       @default(SMALL)
  weightKg           Decimal?          @db.Decimal(8, 3)
  fragile            Boolean           @default(false)
  notes              String?
  goodsAmount        Decimal?          @db.Decimal(12, 2)
  deliveryFee        Decimal?          @db.Decimal(12, 2)
  platformCommission Decimal?          @db.Decimal(12, 2)
  courierEarning     Decimal?          @db.Decimal(12, 2)
  currency           String            @default("EGP") @db.Char(3)
  pricingVersion     Int?
  scheduledFor       DateTime?         @db.Timestamptz(3)
  acceptedAt         DateTime?         @db.Timestamptz(3)
  pickedUpAt         DateTime?         @db.Timestamptz(3)
  deliveredAt        DateTime?         @db.Timestamptz(3)
  cancelledAt        DateTime?         @db.Timestamptz(3)
  cancellationReason String?
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  merchant           Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pickupAddress      Address           @relation("PickupAddress", fields: [pickupAddressId], references: [id], onDelete: Restrict)
  dropoffAddress     Address           @relation("DropoffAddress", fields: [dropoffAddressId], references: [id], onDelete: Restrict)
  courier            CourierProfile?   @relation(fields: [courierId], references: [id], onDelete: Restrict)
  events             OrderEvent[]
  dispatchOffers     DispatchOffer[]
  trackingPoints     TrackingPoint[]
  proofs             ProofOfDelivery[]
  quotes             PriceQuote[]
  ledgerEntries      LedgerEntry[]
  ratings            Rating[]
  supportCases       SupportCase[]

  @@index([merchantId, createdAt])
  @@index([courierId, status])
  @@index([status, createdAt])
}

model OrderEvent {
  id         String                                 @id @default(uuid()) @db.Uuid
  orderId    String                                 @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?                                @db.Uuid
  actorRole  UserRole?
  location   Unsupported("geography(Point, 4326)")?
  notes      String?
  metadata   Json?
  createdAt  DateTime                               @default(now()) @db.Timestamptz(3)
  order      DeliveryOrder                          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor      User?                                  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model DispatchOffer {
  id                     String              @id @default(uuid()) @db.Uuid
  orderId                String              @db.Uuid
  courierId              String              @db.Uuid
  status                 DispatchOfferStatus @default(PENDING)
  expiresAt              DateTime            @db.Timestamptz(3)
  respondedAt            DateTime?           @db.Timestamptz(3)
  distanceToPickupMeters Int?
  expectedEarning        Decimal?            @db.Decimal(12, 2)
  version                Int                 @default(1)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  order                  DeliveryOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier                CourierProfile      @relation(fields: [courierId], references: [id], onDelete: Restrict)

  @@unique([orderId, courierId])
  @@index([courierId, status, expiresAt])
}

model TrackingPoint {
  id         BigInt                                 @id @default(autoincrement())
  courierId  String                                 @db.Uuid
  orderId    String                                 @db.Uuid
  location   Unsupported("geography(Point, 4326)")?
  accuracyM  Float?
  heading    Float?
  speedMps   Float?
  capturedAt DateTime                               @db.Timestamptz(3)
  createdAt  DateTime                               @default(now()) @db.Timestamptz(3)
  courier    CourierProfile                         @relation(fields: [courierId], references: [id], onDelete: Restrict)
  order      DeliveryOrder                          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, capturedAt])
  @@index([courierId, capturedAt])
}

model ProofOfDelivery {
  id            String                                 @id @default(uuid()) @db.Uuid
  orderId       String                                 @db.Uuid
  type          ProofType
  otpHash       String?                                @db.VarChar(255)
  storageKey    String?                                @db.VarChar(500)
  recipientName String?                                @db.VarChar(160)
  location      Unsupported("geography(Point, 4326)")?
  capturedAt    DateTime                               @db.Timestamptz(3)
  createdAt     DateTime                               @default(now()) @db.Timestamptz(3)
  order         DeliveryOrder                          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model PricingRule {
  id                  String       @id @default(uuid()) @db.Uuid
  city                String       @db.VarChar(120)
  area                String       @default("*") @db.VarChar(120)
  version             Int
  currency            String       @default("EGP") @db.Char(3)
  baseFee             Decimal      @db.Decimal(12, 2)
  perKmFee            Decimal      @db.Decimal(12, 2)
  minimumFee          Decimal      @db.Decimal(12, 2)
  waitingFeePerMinute Decimal      @default(0) @db.Decimal(12, 2)
  smallPackageFee     Decimal      @default(0) @db.Decimal(12, 2)
  mediumPackageFee    Decimal      @default(0) @db.Decimal(12, 2)
  largePackageFee     Decimal      @default(0) @db.Decimal(12, 2)
  commissionRate      Decimal      @db.Decimal(5, 4)
  effectiveFrom       DateTime     @db.Timestamptz(3)
  effectiveTo         DateTime?    @db.Timestamptz(3)
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  quotes              PriceQuote[]

  @@unique([city, area, version])
  @@index([city, area, active, effectiveFrom])
}

model PriceQuote {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String?        @db.Uuid
  pricingRuleId   String         @db.Uuid
  distanceMeters  Int
  durationSeconds Int?
  amount          Decimal        @db.Decimal(12, 2)
  commission      Decimal        @db.Decimal(12, 2)
  currency        String         @default("EGP") @db.Char(3)
  breakdown       Json
  expiresAt       DateTime       @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  order           DeliveryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pricingRule     PricingRule    @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([expiresAt])
}

model Wallet {
  id        String          @id @default(uuid()) @db.Uuid
  ownerType WalletOwnerType
  ownerId   String          @db.Uuid
  currency  String          @default("EGP") @db.Char(3)
  balance   Decimal         @default(0) @db.Decimal(14, 2)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  entries   LedgerEntry[]

  @@unique([ownerType, ownerId, currency])
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @db.Uuid
  orderId        String?         @db.Uuid
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(14, 2)
  currency       String          @default("EGP") @db.Char(3)
  idempotencyKey String          @unique @db.VarChar(128)
  reference      String?         @db.VarChar(160)
  metadata       Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order          DeliveryOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([orderId])
}

model Settlement {
  id          String              @id @default(uuid()) @db.Uuid
  ownerType   SettlementOwnerType
  ownerId     String              @db.Uuid
  amount      Decimal             @db.Decimal(14, 2)
  currency    String              @default("EGP") @db.Char(3)
  status      SettlementStatus    @default(PENDING)
  periodStart DateTime            @db.Timestamptz(3)
  periodEnd   DateTime            @db.Timestamptz(3)
  completedAt DateTime?           @db.Timestamptz(3)
  metadata    Json?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@index([ownerType, ownerId, status])
}

model Rating {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @db.Uuid
  authorId  String        @db.Uuid
  subjectId String        @db.Uuid
  score     Int
  tags      String[]
  comment   String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  order     DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author    User          @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  subject   User          @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([orderId, authorId])
  @@index([subjectId, createdAt])
}

model SupportCase {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String?           @db.Uuid
  type         SupportCaseType
  status       SupportCaseStatus @default(OPEN)
  openedById   String            @db.Uuid
  assignedToId String?           @db.Uuid
  description  String
  resolution   String?
  resolvedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  order        DeliveryOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorId    String?   @db.Uuid
  actorRole  UserRole?
  action     String    @db.VarChar(160)
  entityType String    @db.VarChar(100)
  entityId   String    @db.VarChar(160)
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?   @db.Inet
  userAgent  String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model FeatureFlag {
  id             String           @id @default(uuid()) @db.Uuid
  key            String           @unique @db.VarChar(100)
  description    String
  enabled        Boolean          @default(false)
  scope          FeatureFlagScope @default(GLOBAL)
  scopeReference String?          @db.VarChar(160)
  rolloutPercent Int              @default(0)
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@index([scope, scopeReference])
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  phone       String     @db.VarChar(20)
  purpose     OtpPurpose
  codeHash    String     @db.VarChar(255)
  provider    String     @db.VarChar(60)
  providerRef String?    @db.VarChar(160)
  attempts    Int        @default(0)
  expiresAt   DateTime   @db.Timestamptz(3)
  consumedAt  DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @db.Uuid
  refreshTokenHash         String    @unique @db.Char(64)
  previousRefreshTokenHash String?   @unique @db.Char(64)
  expiresAt                DateTime  @db.Timestamptz(3)
  revokedAt                DateTime? @db.Timestamptz(3)
  revokedReason            String?   @db.VarChar(160)
  lastUsedAt               DateTime? @db.Timestamptz(3)
  ipAddress                String?   @db.Inet
  userAgent                String?   @db.VarChar(500)
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id           String            @id @default(uuid()) @db.Uuid
  scope        String            @db.VarChar(100)
  key          String            @db.VarChar(128)
  requestHash  String            @db.VarChar(128)
  status       IdempotencyStatus @default(PROCESSING)
  responseCode Int?
  responseBody Json?
  expiresAt    DateTime          @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
}
