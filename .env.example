NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://wasel:wasel_local_password@localhost:5432/wasel?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
OTP_MOCK_CODE=123456
OTP_PEPPER=local-only-otp-pepper-change-before-production
ACCESS_TOKEN_SECRET=local-only-access-secret-change-before-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
STORAGE_LOCAL_DIR=.data/uploads
DOCUMENT_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
