NODE_ENV=development
APP_ENV=development
API_PORT=3100
DATABASE_URL=postgresql://wasel:wasel_local_password@localhost:5432/wasel?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
OTP_MOCK_CODE=123456
OTP_PEPPER=local-only-otp-pepper-change-before-production
ACCESS_TOKEN_SECRET=local-only-access-secret-change-before-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_DRIVER=local
# Production/staging private S3-compatible storage (never commit real values):
# S3_ENDPOINT=https://objects.example.invalid
# S3_REGION=eu-central-1
# S3_BUCKET=wassal-production-private
# S3_ACCESS_KEY_ID=replace-via-secret-manager
# S3_SECRET_ACCESS_KEY=replace-via-secret-manager
# S3_PREFIX=production
# S3_FORCE_PATH_STYLE=false
TRUST_PROXY=false
DOCUMENT_MAX_BYTES=5242880
QUOTE_TTL_SECONDS=900
ORDER_MAX_WEIGHT_GRAMS=25000
ORDER_MAX_DECLARED_VALUE_MINOR=500000
QUOTE_RATE_LIMIT_PER_MINUTE=30
ORDER_RATE_LIMIT_PER_MINUTE=20
# Pilot-only password registration. Keep false outside an explicitly approved pilot.
MERCHANT_PILOT_REGISTRATION_ENABLED=false
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3100/api/v1
# Reserved: remains disabled until an approved zero-cost geocoder is integrated.
NEXT_PUBLIC_MAP_TEXT_SEARCH_ENABLED=false
# Replace this example with the development computer's LAN IPv4 address.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3100/api/v1
