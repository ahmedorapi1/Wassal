{
  "name": "wasel",
  "version": "0.0.0",
  "private": true,
  "description": "Wasel on-demand delivery platform monorepo",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean",
    "dev": "dotenv -e .env -- turbo run dev --parallel",
    "dev:api": "dotenv -e .env -- pnpm --filter @wasel/api dev",
    "dev:admin": "pnpm --filter @wasel/admin-web dev",
    "dev:merchant": "pnpm --filter @wasel/merchant-web dev",
    "dev:courier": "pnpm --filter @wasel/courier-mobile dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @wasel/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.15.46",
    "@types/node": "26.1.1",
    "@types/supertest": "7.2.1",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "prisma": "7.9.0",
    "turbo": "2.10.6",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
